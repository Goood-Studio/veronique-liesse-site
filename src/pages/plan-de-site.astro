---
import Base from '../layouts/Base.astro';
import { FORMATIONS_PUBLIEES } from '../data/cms';
import { u } from '../data/site';
const pages = [
  ['/', 'Accueil'], ['/formation-menopause/', 'Formation ménopause'], ['/webinaire-soja-menopause/', 'Webinaire gratuit'], ['/temoignages/', 'Témoignages'],
  ['/formations/', 'Toutes les formations'], ['/formations-micronutrition/', 'Se former à la micronutrition'],
  ['/veronique-liesse/', 'À propos'], ['/qvt-en-entreprise-renforcer-qualite-de-vie/', 'Ateliers en entreprise'],
  ['/consultation-nutritionniste/', 'Consultations à Monaco'], ['/mes-livres/', 'Livres'], ['/revue-de-presse/', 'Revue de presse'],
  ['/contact/', 'Contact'], ['/mentions-legales/', 'Mentions légales'], ['/cgv-cgu-confidentialite/', 'CGV, CGU et confidentialité'],
];
---
<Base titre="Plan du site | Véronique Liesse Nutrition" description="Toutes les pages du site de Véronique Liesse : formations en ligne, webinaire, ateliers en entreprise, consultations, livres et contact." chemin="/plan-de-site/">
  <section class="section">
    <div class="conteneur deux">
      <div><h1>Plan du site</h1><ul>{pages.map(([h, l]) => <li><a href={u(h)}>{l}</a></li>)}</ul></div>
      <div><h2>Les formations</h2><ul>{FORMATIONS_PUBLIEES.map((f) => <li><a href={u(`/formations/${f.slug}/`)}>{f.titre}</a></li>)}</ul></div>
    </div>
  </section>
</Base>
<style>
  .deux { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  li { margin-bottom: 8px; }
  @media (max-width: 800px) { .deux { grid-template-columns: 1fr; } }
</style>
