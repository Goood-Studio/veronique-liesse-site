---
import Base from '../layouts/Base.astro';
import { WEBINAIRE, SITE, u } from '../data/site';
const debut = (WEBINAIRE.date + 'T' + (WEBINAIRE.heure || '19:00')).replace(/[-:]/g, '');
const fin = (() => {
  const d = new Date(`${WEBINAIRE.date}T${WEBINAIRE.heure || '19:00'}:00`);
  d.setMinutes(d.getMinutes() + WEBINAIRE.dureeMin);
  const p = (n: number) => String(n).padStart(2, '0');
  return `${d.getFullYear()}${p(d.getMonth() + 1)}${p(d.getDate())}T${p(d.getHours())}${p(d.getMinutes())}00`;
})();
const google = 'https://calendar.google.com/calendar/render?action=TEMPLATE'
  + '&text=' + encodeURIComponent('Webinaire Véronique Liesse : ' + WEBINAIRE.titre)
  + '&dates=' + debut + '00/' + fin + '&ctz=Europe/Monaco'
  + '&details=' + encodeURIComponent('Le lien de connexion est dans l’email de confirmation.');
---
<Base titre="Ta place est réservée | Véronique Liesse" description="Ton inscription au webinaire gratuit de Véronique Liesse est confirmée. Ajoute-le à ton agenda et suis-la en attendant." chemin="/merci-webinaire/" noindex>
  <section class="section">
    <div class="conteneur etroit">
      <h1>Merci<span id="prenom"></span>, ta place est réservée</h1>
      <p class="chapo">Tu vas recevoir un email de confirmation avec le lien de connexion. Pense à vérifier tes courriers indésirables, et à ajouter l’adresse de Véronique à tes contacts.</p>
      <ol class="etapes">
        <li><strong>Ajoute le webinaire à ton agenda</strong> : {WEBINAIRE.dateLongue}{WEBINAIRE.heureTexte ? ` à ${WEBINAIRE.heureTexte}` : ''}, {WEBINAIRE.dureeMin} minutes.
          {WEBINAIRE.heure && <div class="actions"><a class="btn btn-mer" href={google} target="_blank" rel="noopener">Google Agenda</a></div>}
        </li>
        <li><strong>Le jour J</strong>, la salle ouvre 30 minutes avant : le lien direct est dans l’email de rappel.</li>
        <li><strong>En attendant</strong>, suis Véronique sur <a href={SITE.instagram} target="_blank" rel="noopener">Instagram</a> et <a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a>.</li>
      </ol>
      <a href={u('/formations/')}>Découvrir les autres formations →</a>
    </div>
  </section>
</Base>
<script is:inline>
  var p = new URLSearchParams(location.search).get('prenom');
  if (p) document.getElementById('prenom').textContent = ' ' + p.slice(0, 40);
</script>
<style>
  .etroit { max-width: 760px; }
  .etapes { padding-left: 1.2em; margin: 32px 0; }
  .etapes li { margin-bottom: 18px; }
  .actions { margin-top: 12px; }
</style>
