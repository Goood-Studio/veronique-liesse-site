---
// Logo officiel (idée 2 horizontale, validée le 26/11/2026) : rameau d'olivier
// + « Véronique Liesse » + NUTRITION · MICROBIOTE. Fichiers vectoriels dans
// public/img/logo/ (version normale, version claire pour fonds mer/olivier,
// rameau seul). Texte vectorisé : aucune police à charger.
import { u } from '../data/site';
interface Props { clair?: boolean }
const { clair = false } = Astro.props;
const src = u(`/img/logo/logo-veronique-liesse${clair ? '-clair' : ''}.svg`);
---
<img class="logo" src={src} width="2894" height="642" alt="Véronique Liesse, nutrition et microbiote" decoding="async" />
<style>
  .logo { display: block; height: 52px; width: auto; max-width: 100%; }
  @media (max-width: 400px) { .logo { height: 42px; } }
</style>
