---
// Le bandeau d'annonce, en haut de toutes les pages : il porte le CTA
// principal du moment (le webinaire, puis l'offre de lancement).
import { PHASE, WEBINAIRE, OFFRE, u } from '../data/site';
const fermee = PHASE === 'fermee';
---
{!fermee && (
  <div class="bandeau">
    <div class="conteneur interieur">
      {PHASE === 'attente' ? (
        <p>
          <strong class="masquer-mobile">Webinaire gratuit le {WEBINAIRE.dateLongue}</strong>
          <strong class="seulement-mobile">Webinaire gratuit · {WEBINAIRE.dateCourte}</strong>
          <span class="masquer-mobile"> · pour les professionnel·les de santé</span>
        </p>
      ) : (
        <p>
          <strong>Formation ménopause ouverte</strong>
          <span class="masquer-mobile"> · offre de lancement à {OFFRE.prixLancement} € pendant 48 h</span>
        </p>
      )}
      <a href={PHASE === 'attente' ? u('/webinaire-soja-menopause/') : u('/formation-menopause/')}>
        {PHASE === 'attente' ? 'Je m’inscris' : 'Découvrir'}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
)}
<style>
  .bandeau { background: var(--mer); color: var(--chaux); font-size: .92rem; }
  .interieur { display: flex; align-items: center; justify-content: center; gap: 14px; min-height: 44px; padding-top: 8px; padding-bottom: 8px; text-align: center; flex-wrap: wrap; }
  p { margin: 0; }
  a { color: var(--chaux); font-weight: 600; text-decoration: underline; text-decoration-color: var(--ocre); text-decoration-thickness: 2px; white-space: nowrap; }
  a:hover { color: var(--sable); }
  .seulement-mobile { display: none; }
  @media (max-width: 640px) {
    .masquer-mobile { display: none; }
    .seulement-mobile { display: inline; }
    .interieur { flex-wrap: nowrap; gap: 12px; min-height: 40px; font-size: .88rem; }
  }
</style>
